# =====================================================================
# TableTap — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# =====================================================================

# ---------------------------------------------------------------- app
# Public base URL. Used for QR/NFC links and printable QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the staff session cookie (HMAC). REQUIRED in production: the server
# refuses to sign a cookie (staff sign-in returns an error) until this is at
# least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Locally, `npm run dev` / `npm start` generate one into .env.local for you.
SESSION_SECRET=

# Protects /api/cron/housekeeping. Send it as `Authorization: Bearer <key>`,
# `x-cron-key` or `?key=`. With this empty, a production deployment answers 503
# (fails closed) — there is no "user-agent looks like cron" bypass.
CRON_SECRET=

# ---------------------------------------------------------------- database
# Leave DATABASE_URL empty to run the embedded local database (PGlite) —
# perfect for demos and development, nothing to install.
#
# Supabase: Project Settings → Database → Connection string → "Connection pooling"
# (session mode, port 5432 on the pooler host), e.g.
# DATABASE_URL=postgresql://postgres.abcdefgh:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional: persist the embedded database to disk instead of memory
# PGLITE_DIR=.pglite

# ---------------------------------------------------------------- supabase
# Required for Supabase Auth (staff logins), Realtime and Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- web push
# Generate a key pair once:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@your-restaurant.com

# ---------------------------------------------------------------- demo
# Password used by `npm run seed:staff`, the /setup screen and /api/demo/seed.
DEMO_PASSWORD=Demo@1234

# ---------------------------------------------------------------- demo
# Enables the one-click demo button on the landing page (/api/demo/seed).
# Demo routes only ever run on the embedded database, never on a real Postgres.
# Default: on in development, off in production.
# In production the server refuses to start without DATABASE_URL; the only way around
# that is DEMO_MODE=on, meant for a throwaway local demo. Leave it empty or "off" live.
# Demo logins use DEMO_PASSWORD above: the owner changes them (Admin → Staff) before going live.
DEMO_MODE=
