{
  "name": "tabletap",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant NFC/QR ordering platform \u2014 TableTap by U&D Digital Studio",
  "scripts": {
    "dev": "node scripts/ensure-secret.mjs && next dev -H 0.0.0.0 -p 3000",
    "dev:fast": "node scripts/ensure-secret.mjs && next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node scripts/ensure-secret.mjs && next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "qr:pdf": "node scripts/generate-qr-pdf.mjs",
    "seed:staff": "node scripts/seed-staff.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:e2e": "node flow.mjs",
    "test:qa": "node scripts/final-qa.mjs",
    "test:edge": "node scripts/edge-cases.mjs",
    "test:prod": "node scripts/prod-gates-test.mjs",
    "test:password": "node scripts/password-flow-test.mjs",
    "test:games": "node scripts/game-clock-test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.1.6",
    "pdfkit": "^0.15.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  }
}
